{
  "name": "@toknomics/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "api": "tsx --env-file-if-exists=.env src/api/server.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "start": "node --env-file-if-exists=.env --import tsx src/start.ts",
    "verify": "tsx --env-file=.env scripts/verify-gift-pipeline.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "db:push": "supabase db push --workdir ..",
    "fake-euler": "tsx scripts/fake-euler.ts"
  },
  "dependencies": {
    "@eulerstream/euler-websocket-sdk": "1.0.0",
    "@hono/node-server": "^2.1.4",
    "@supabase/supabase-js": "^2.117.3",
    "@toknomics/shared": "*",
    "hono": "^4.13.13",
    "stripe": "^23.0.0",
    "tiktok-live-api-sdk": "0.6.1",
    "tsx": "^4.23.15",
    "ws": "^8.18.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.12",
    "tsx": "^4.23.15",
    "vitest": "^5.0.4"
    "vitest": "^5.0.5"
  }
}

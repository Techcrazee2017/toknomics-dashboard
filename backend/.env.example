# Backend env (API + worker). Copy to backend/.env for local runs; in production set these as Railway
# service variables instead. Never ship any of these to the browser.

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# The secret key (sb_secret_…) or the legacy service_role JWT. A publishable/anon key is rejected at boot.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts Euler keys/cookies/tokens at rest.
# Keep a copy in a password manager: losing or rotating it makes stored credentials unreadable,
# and Founders would have to re-enter them.
CREDENTIALS_KEY=

# ── API server ───────────────────────────────────────────────────────────────
# Railway injects PORT; 8787 is the local default.
PORT=8787
# Exact web origin: CORS allows only this origin, and it's the base for Stripe/OAuth/invite redirects.
# Production: https://toknomics.backwoodstechsolutions.com
WEB_ORIGIN=http://localhost:5173
# This API's own public URL. Production: https://api.toknomics.backwoodstechsolutions.com
API_PUBLIC_URL=http://localhost:8787
# EULER_API_BASE=https://api.eulerstream.com        (optional REST override)

# ── Euler OAuth app (Data source → OAuth mode) ───────────────────────────────
# Redirect URI to register: $API_PUBLIC_URL/api/euler/oauth/callback
EULER_OAUTH_CLIENT_ID=
EULER_OAUTH_CLIENT_SECRET=
# Authorization endpoint from your Euler OAuth app settings
EULER_OAUTH_AUTHORIZE_URL=

# ── Stripe billing (Plan & billing) ──────────────────────────────────────────
# Webhook endpoint: $API_PUBLIC_URL/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# ── Worker ───────────────────────────────────────────────────────────────────
# Uses each agency's own Euler API key from Data source. Leave unset for the default (200).
MAX_SOCKETS=200
# EULER_WS_URL=wss://ws.eulerstream.com             (optional host override, read by the SDK)

# ── Verify script only (simulates the frontend's scope; dev/staging projects only) ─
SUPABASE_ANON_KEY=

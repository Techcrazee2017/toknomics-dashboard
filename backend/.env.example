# ── Server only. Never ship these to the browser. ──
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64: openssl rand -base64 32. Encrypts Euler keys/cookies/tokens at rest.
# Rotating it makes stored credentials unreadable; founders would re-enter them.
CREDENTIALS_KEY=

# API server (npm run api)
PORT=8787
WEB_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:8787
# EULER_API_BASE=https://api.eulerstream.com        (optional REST override)

# Euler OAuth app (Data source → OAuth mode). Redirect URI to register: $API_PUBLIC_URL/api/euler/oauth/callback
EULER_OAUTH_CLIENT_ID=
EULER_OAUTH_CLIENT_SECRET=
# Authorization endpoint from your Euler OAuth app settings
EULER_OAUTH_AUTHORIZE_URL=

# Stripe billing (Plan & billing). Webhook endpoint: $API_PUBLIC_URL/api/stripe/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_SCALE=

# Worker (npm run worker). Uses each agency's own Euler API key from Data source.
MAX_SOCKETS=200
# EULER_WS_URL=wss://ws.eulerstream.com             (optional host override, read by the SDK)

# Verify script only (simulates the frontend's scope)
SUPABASE_ANON_KEY=

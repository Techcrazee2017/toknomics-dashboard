# Web env. Copy to web/.env.local (Vite only reads env files from web/, not the repo root).
# In production set these in the Vercel project for Production and Preview. They're inlined at
# build time, so redeploy after changing them.
# Public values only: the anon/publishable key is safe in the browser because RLS scopes every row.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
# Production: https://api.toknomics.backwoodstechsolutions.com
VITE_API_URL=http://localhost:8787

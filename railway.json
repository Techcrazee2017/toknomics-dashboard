{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run typecheck -w backend",
    "watchPatterns": ["backend/**", "shared/**", "package.json", "package-lock.json", ".nvmrc", "railway.json"]
  },
  "deploy": {
    "startCommand": "cd backend && exec node --import tsx src/start.ts",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ALWAYS",
    "numReplicas": 1,
    "sleepApplication": false,
    "drainingSeconds": 30
  }
}
